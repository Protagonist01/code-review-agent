# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=keys/private-key.pem
GITHUB_WEBHOOK_SECRET=

# LLM Backend
# Choose one: groq | ollama | openai | anthropic | openrouter
LLM_PROVIDER=openrouter

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:7b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter - OpenAI-compatible routing, including free :free models
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default code-focused free model as of 2026-06; swap to any current :free model
OPENROUTER_MODEL=cohere/north-mini-code:free
# Optional attribution headers shown in OpenRouter analytics/rankings
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=code-review-agent

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Review Policy
MAX_DIFF_LINES=1500
MIN_COMMENT_SEVERITY=warning

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
